SECRET_KEY=change-me
DEBUG=True
DATABASE_URL=postgres://truckparts:truckparts@localhost:5440/truckparts

# AI: any OpenAI-compatible endpoint. Leave LLM_API_KEY empty (or AI_MOCK=True) for offline mock mode.
AI_MOCK=True
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# Vision / embedding may use a different provider, e.g. 通义 DashScope compatible mode:
# VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VISION_API_KEY=
# VISION_MODEL=qwen-vl-max
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-v3

# Process supplier uploads inside the request (local dev without a qcluster worker)
Q_SYNC=True
